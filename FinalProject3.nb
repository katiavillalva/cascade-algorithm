Cell[CellGroupData[{

Cell["\<\
 Approximate the wavelet functions from the D4 and D8 scaling functions\
\>", "Subsection",
 CellChangeTimes->{{3.9877341138647623`*^9, 
  3.987734180233844*^9}},ExpressionUUID->"3f95ba31-a762-4f6d-ac90-\
afd448455061"],

Cell[BoxData[
 RowBox[{
  RowBox[{"WaveletApproximation", "[", 
   RowBox[{"h_", ",", "scaling_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"psi", ",", " ", "g", " ", ",", " ", "len"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"len", " ", "=", " ", 
      RowBox[{"Length", "[", "h", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"h", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"(", "k", ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "len"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"psi", "[", "x_", "]"}], "=", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"[", 
            RowBox[{"k", " ", "+", " ", "len", " ", "-", " ", "1"}], "]"}], 
           "]"}], "*", 
          RowBox[{"scaling", "[", 
           RowBox[{
            RowBox[{"2", "*", "x"}], "-", "k"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"2", "-", "len"}], " ", ",", "1"}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"psi", "[", "x", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.987717046300284*^9, 3.987717194142297*^9}, 
   3.987717236278449*^9, {3.9877173689267*^9, 3.987717374909606*^9}, {
   3.9877176106913147`*^9, 3.987717652070675*^9}, {3.98771810936351*^9, 
   3.987718112086829*^9}, {3.987718198049614*^9, 3.987718366345635*^9}, {
