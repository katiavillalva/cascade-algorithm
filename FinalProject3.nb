Cell[BoxData[
 RowBox[{
  RowBox[{"Construction3", "[", 
   RowBox[{"h_", ",", " ", "iter_", ",", " ", "m_"}], "]"}], " ", ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "phi", ",", "L", ",", " ", "data", ",", " ", "len", ",", " ", "eig"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"phi", "[", "x_", "]"}], " ", "=", " ", "0"}], ";", " ", 
     RowBox[{"data", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Get", " ", "the", " ", "values", " ", "of", " ", "phi", 
       RowBox[{"(", "x", ")"}], " ", "at", " ", "integers", " ", "between", " ",
        "0", " ", "and", " ", "len"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"len", " ", "=", " ", 
      RowBox[{"Length", "[", "h", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"L", " ", "=", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
           RowBox[{"0", "<=", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "*", "i"}], "-", "j"}], ")"}], "<=", 
            RowBox[{"len", "-", "1"}]}]}], ":>", 
          RowBox[{"h", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"2", "*", "i"}], "-", "j", "+", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"len", "-", "2"}], ",", 
           RowBox[{"len", "-", "2"}]}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eig", " ", "=", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], "*", 
       RowBox[{"Simplify", "[", 
        RowBox[{"m", "*", 
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"Eigenvectors", "[", "L", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"phi", "[", "n", "]"}], " ", "=", " ", 
        RowBox[{"eig", "[", 
         RowBox[{"[", "n", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"len", "-", "2"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Get", " ", "the", " ", "values", " ", "of", " ", "phi", 
       RowBox[{"(", "x", ")"}], " ", "at", " ", "dyadic", " ", "points", " ", 
       
       RowBox[{"n", "/", 
        RowBox[{"2", "^", "j"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"data", ",", " ", 
       RowBox[{"Splice", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"phi", "[", "1", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{"phi", "[", "2", "]"}]}], "}"}]}], "}"}], "]"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"phi", "[", 
            RowBox[{"n", "/", 
             RowBox[{"(", 
              RowBox[{"2", "^", "j"}], ")"}]}], "]"}], " ", "=", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Sqrt", "[", "2", "]"}], "*", 
              RowBox[{"h", "[", 
               RowBox[{"[", 
                RowBox[{"k", "+", "1"}], "]"}], "]"}], "*", 
              RowBox[{"phi", "[", 
               RowBox[{
                RowBox[{"2", "*", 
                 RowBox[{"(", 
                  RowBox[{"n", "/", 
                   RowBox[{"(", 
                    RowBox[{"2", "^", "j"}], ")"}]}], ")"}]}], "-", "k"}], 
               "]"}]}], ",", "\[IndentingNewLine]", "  ", 
             RowBox[{"{", 
              RowBox[{"k", ",", "0", ",", 
               RowBox[{"len", "-", "1"}]}], "}"}]}], "]"}]}], ";", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"data", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"n", "/", 
               RowBox[{"(", 
                RowBox[{"2", "^", "j"}], ")"}]}], ",", 
              RowBox[{"phi", "[", 
               RowBox[{"n", "/", 
                RowBox[{"(", 
                 RowBox[{"2", "^", "j"}], ")"}]}], "]"}]}], "}"}]}], "]"}]}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "1", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"len", "-", "1"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"2", "^", "j"}], ")"}]}], "-", "1"}], ",", "2"}], 
          "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "iter"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "data"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
