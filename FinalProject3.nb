dd2ff61c9c7d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Takes", " ", "scaling", " ", "filter", " ", "coefficients", " ", "and", " ",
      "returns", " ", "the", " ", "n"}], "-", 
    RowBox[{
    "th", " ", "approximation", " ", "for", " ", "the", " ", "scaling", " ", 
     "function"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Cascade", "[", 
    RowBox[{"h_", ",", " ", "n_"}], "]"}], ":=", " ", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "phi", "}"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"phi", "[", "x_", "]"}], " ", "=", " ", 
       RowBox[{"Piecewise", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"0", "<=", "x", "<", "1"}]}], "}"}], "}"}], ",", "0"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Define", " ", "phi", 
        RowBox[{"(", "x", ")"}], " ", "recursively"}], " ", "*)"}], 
      "\[IndentingNewLine]", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"phi", "[", "x_", "]"}], "=", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "2", "]"}], "*", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"h", "[", 
              RowBox[{"[", 
               RowBox[{"k", "+", "1"}], "]"}], "]"}], "*", 
             RowBox[{"phi", "[", 
              RowBox[{
               RowBox[{"2", "*", "x"}], "-", "k"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{
               RowBox[{"Length", "[", "h", "]"}], "-", "1"}]}], "}"}]}], 
           "]"}]}]}], ",", "n"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"phi", "[", "x", "]"}]}]}], "]"}]}]}]], "Input",
