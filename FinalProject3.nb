FractionBox[RowBox[{\\\"3\\\", \\\"-\\\", SqrtBox[\\\"3\\\"]}], RowBox[{\\\"4\
\\\", \\\" \\\", SqrtBox[\\\"2\\\"]}]], \\\",\\\", \
FractionBox[RowBox[{\\\"1\\\", \\\"-\\\", SqrtBox[\\\"3\\\"]}], RowBox[{\\\"4\
\\\", \\\" \\\", SqrtBox[\\\"2\\\"]}]]}], \\\"}\\\"}]\\)\"\>",
   StringForm[
   "D4       ``", {
    Rational[1, 4] 2^Rational[-1, 2] (1 + 3^Rational[1, 2]), Rational[1, 4] 
     2^Rational[-1, 2] (3 + 3^Rational[1, 2]), Rational[1, 4] 
     2^Rational[-1, 2] (3 - 3^Rational[1, 2]), Rational[1, 4] 
     2^Rational[-1, 2] (1 - 3^Rational[1, 2])}],
