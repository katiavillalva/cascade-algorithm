3a5e33751573"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"D4coefficients", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Sqrt", "[", "3", "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{"Sqrt", "[", "3", "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "-", 
        RowBox[{"Sqrt", "[", "3", "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Sqrt", "[", "3", "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqns", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"L", "=", 
       RowBox[{"n", "-", "1"}]}], ",", 
      RowBox[{"k", "=", "2"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"Clear", "[", "h", "]"}], ";", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"h", "[", "i", "]"}], "^", "2"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "L"}], "}"}]}], "]"}], "==", "1"}], 
        "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"h", "[", "i", "]"}], " ", 
             RowBox[{"h", "[", 
              RowBox[{"i", "+", 
               RowBox[{"2", " ", "k"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"L", "-", 
               RowBox[{"2", " ", "k"}]}]}], "}"}]}], "]"}], "==", "0"}], ",", 
         
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"L", "-", "1"}], ")"}], "/", "2"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", "i"}], " ", 
            RowBox[{"h", "[", "i", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "L"}], "}"}]}], "]"}], "==", "0"}], 
        "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"i", "+", "1"}], ")"}]}], " ", 
             RowBox[{"i", "^", "k"}], " ", 
             RowBox[{"h", "[", "i", "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "L"}], "}"}]}], "]"}], "==", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"L", "-", "1"}], ")"}], "/", "2"}]}], "}"}]}], "]"}]}], 
      "]"}]}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"D8coefficients", "=", 
   RowBox[{
    RowBox[{"Last", "[", 
     RowBox[{"NSolve", "[", 
      RowBox[{"eqns", "[", "8", "]"}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "2"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"Style", "[", 
   RowBox[{
    RowBox[{"StringForm", "[", 
     RowBox[{"\"\<D4       ``\>\"", ",", "D4coefficients"}], "]"}], ",", 
    "16"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"Style", "[", 
   RowBox[{
    RowBox[{"StringForm", "[", 
     RowBox[{"\"\<D8       ``\>\"", ",", "D8coefficients"}], "]"}], ",", 
    "16"}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.987632488082819*^9, 3.9876325113520107`*^9}, {
  3.987732583161457*^9, 3.9877326150456543`*^9}, {3.9877772843805103`*^9, 
