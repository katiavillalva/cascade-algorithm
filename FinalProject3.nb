 StyleBox[
  InterpretationBox["\<\"D4       \\!\\(\\*RowBox[{\\\"{\\\", \
RowBox[{FractionBox[RowBox[{\\\"1\\\", \\\"+\\\", SqrtBox[\\\"3\\\"]}], \
RowBox[{\\\"4\\\", \\\" \\\", SqrtBox[\\\"2\\\"]}]], \\\",\\\", \
FractionBox[RowBox[{\\\"3\\\", \\\"+\\\", SqrtBox[\\\"3\\\"]}], RowBox[{\\\"4\
